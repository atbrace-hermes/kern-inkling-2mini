#!/usr/bin/env bash
# loop/withgpu CMD...: run CMD holding the exclusive GPU flock lease.
# EVERY GPU command across the swarm MUST run through this wrapper.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/env.sh"
exec {fd}>"$STATE/gpu$GPU.lock"
if ! flock -n "$fd"; then
  echo "withgpu: waiting for GPU $GPU" >&2
  flock "$fd"
fi
CUDA_VISIBLE_DEVICES=$GPU "$@"
