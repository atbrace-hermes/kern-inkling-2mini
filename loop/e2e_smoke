#!/usr/bin/env bash
# loop/e2e_smoke BUNDLE OUT: anti-drift anchor via `kern test e2e-logits` against official vLLM
# smoke_reference.parquet under loop/withgpu. Writes OUT.parquet and OUT.log; exit 0 PASS.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/env.sh"

bundle=$(realpath "$1")
out=$(realpath -m "$2")
mkdir -p "$(dirname "$out")"

weights_dir="$bundle/weights_inkling_1m"
[[ -d "$weights_dir" ]] || weights_dir="$STATE/main/bundle/weights_inkling_1m"

"$LOOP/withgpu" "$KERN" test e2e-logits \
  --manifest "$bundle/model.json" \
  --kernels "$bundle/kernels" \
  --weights "$weights_dir" \
  --reference "$SMOKE_REF" \
  --gpu 0 \
  --out "$out.parquet" > "$out.log" 2>&1
rc=$?
cat "$out.log"
exit $rc
